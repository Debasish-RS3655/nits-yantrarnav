/bin/python /home/nits/master_controller/nits-yantrarnav/ros2_Ws/src/my_robot_controller/my_robot_controller/flat_area_processor.py

def main(args=None):
    rclpy.init(args=args)
    node = FlatAreaProcessor()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
